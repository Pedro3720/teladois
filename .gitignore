# Xcode (projeto é gerado pelo XcodeGen no CI)
ios/*.xcodeproj/
ios/*.xcworkspace/
/build/
/DerivedData/
*.xcresult
/TestResults.xcresult
*.ipa
/Payload/
/screenshots/
# Pasta local onde o Claude entrega o .ipa ao usuário (e onde a bancada grava; ignorada em qualquer nível)
builds/

# .NET
windows/**/bin/
windows/**/obj/
*.user

# Node / Playwright (protótipo)
node_modules/
/prototype/node_modules/
/prototype/test-results/
/prototype/playwright-report/

# Prints e logs do Playwright MCP (verificação manual)
/.playwright-mcp/

# graphify: versiona só o grafo, o relatório e o manifesto (o resto é cache local / caminho deste PC)
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/manifest.json
!/graphify-out/.graphify_labels.json

# Segredos e credenciais (nunca versionar)
.env
.env.*
*.pem
*.key
*.p12
*.cer
*.mobileprovision
*.keystore
*.jks
.claude/settings.local.json

# Build local do pacote Swift (se alguém rodar swift no Mac)
ios/Packages/*/.build/

# Logs soltos (ex.: sideloadlydaemon.log que o Sideloadly cria na pasta de onde é aberto)
*.log

# SO / editores
.DS_Store
Thumbs.db
.vs/
.vscode/
