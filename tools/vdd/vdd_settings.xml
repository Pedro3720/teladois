<?xml version='1.0' encoding='utf-8'?>
<!-- Configuração do Virtual Display Driver 25.7.23 para o TelaDois (instalada por tools/vdd/instalar-vdd.ps1). -->
<!-- 1 monitor sempre instalado: o TelaDois só o põe e tira do desktop. Resoluções em paisagem dos iPhones 15/16/17. -->
<!-- Mesmo formato do vdd_settings.xml que vem no pacote 25.7.23 (bloco <options>). -->
<vdd_settings>
    <monitors>
        <count>1</count>
    </monitors>
    <gpu>
        <friendlyname>default</friendlyname>
    </gpu>
    <global>
        <g_refresh_rate>60</g_refresh_rate>
    </global>
    <resolutions>
        <resolution>
            <width>2556</width>
            <height>1179</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>2796</width>
            <height>1290</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>2622</width>
            <height>1206</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>2868</width>
            <height>1320</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>2736</width>
            <height>1260</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>1920</width>
            <height>1080</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <!-- Etapa 5d: as mesmas resoluções ÷ 1,75 (par mais próximo), para o monitor do iPhone em escala 100%. -->
        <resolution>
            <width>1460</width>
            <height>674</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>1598</width>
            <height>738</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>1498</width>
            <height>690</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>1638</width>
            <height>754</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>1564</width>
            <height>720</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
    </resolutions>
    <options>
        <CustomEdid>false</CustomEdid>
        <PreventSpoof>false</PreventSpoof>
        <EdidCeaOverride>false</EdidCeaOverride>
        <HardwareCursor>true</HardwareCursor>
        <SDR10bit>false</SDR10bit>
        <HDRPlus>false</HDRPlus>
        <logging>false</logging>
        <debuglogging>false</debuglogging>
    </options>
</vdd_settings>
